---
type Props = {
  text: string
  icon: string
}

const { text, icon } = Astro.props
---

<span class="inline-flex items-center gap-2">
  <svg height={20} width={20} aria-hidden="true">
    <use href={`/stack.svg#${icon}`}></use>
  </svg>
  <span class="text-sm text-neutral-500 dark:text-neutral-400">
    {text}
  </span>
</span>